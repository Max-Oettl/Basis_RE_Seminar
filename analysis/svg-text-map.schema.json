{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "basis-re-svg-text-map.schema.json",
  "title": "Basis RE SVG to extracted DOCX text mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "module_root",
    "svg_root",
    "text_root",
    "mapping_status",
    "documents",
    "mappings",
    "unmapped_svgs",
    "unmapped_documents",
    "unmapped_text_sections",
    "deferred_documents",
    "deferred_text_sections",
    "qa"
  ],
  "properties": {
    "schema_version": { "const": "basisReSvgTextMap/v1" },
    "module_id": { "type": "string", "pattern": "^RE[1-5]$" },
    "module_root": { "type": "string", "minLength": 1 },
    "svg_root": { "type": "string", "minLength": 1 },
    "text_root": { "type": "string", "minLength": 1 },
    "mapping_status": { "enum": ["mapped", "needs_review", "blocked"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mapping" }
    },
    "unmapped_svgs": { "$ref": "#/$defs/stringArray" },
    "unmapped_documents": { "$ref": "#/$defs/stringArray" },
    "unmapped_text_sections": { "$ref": "#/$defs/stringArray" },
    "deferred_documents": { "$ref": "#/$defs/stringArray" },
    "deferred_text_sections": { "$ref": "#/$defs/stringArray" },
    "qa": { "$ref": "#/$defs/qa" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues", "warnings", "open_questions"],
      "properties": {
        "issues": { "$ref": "#/$defs/stringArray" },
        "warnings": { "$ref": "#/$defs/stringArray" },
        "open_questions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_docx",
        "source_sha256",
        "extracted_markdown",
        "extracted_sha256",
        "extraction_status",
        "paragraph_count",
        "table_count",
        "notes"
      ],
      "properties": {
        "source_docx": { "type": "string", "pattern": "\\.docx$" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "extracted_markdown": { "type": "string", "pattern": "\\.md$" },
        "extracted_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_status": {
          "enum": ["ready", "needs_review", "blocked"]
        },
        "paragraph_count": { "type": "integer", "minimum": 0 },
        "table_count": { "type": "integer", "minimum": 0 },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_slide_key",
        "source_slide_number",
        "source_svg",
        "source_svg_sha256",
        "source_docx",
        "extracted_markdown",
        "source_text_section_id",
        "source_text_local_slide_numbers",
        "source_text_title",
        "shared_text_group",
        "mapping_method",
        "mapping_confidence",
        "mapping_status",
        "spoken_text",
        "spoken_text_sha256",
        "supplementary_information",
        "notes",
        "qa"
      ],
      "properties": {
        "source_slide_key": {
          "type": "string",
          "pattern": "^slide_[0-9]{3,}$"
        },
        "source_slide_number": { "type": "integer", "minimum": 1 },
        "source_svg": { "type": "string", "pattern": "\\.[sS][vV][gG]$" },
        "source_svg_sha256": { "$ref": "#/$defs/sha256" },
        "source_docx": { "type": "string", "pattern": "\\.docx$" },
        "extracted_markdown": { "type": "string", "pattern": "\\.md$" },
        "source_text_section_id": {
          "type": "string",
          "pattern": "^section_[0-9]{3,}$"
        },
        "source_text_local_slide_numbers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "source_text_title": { "type": "string", "minLength": 1 },
        "shared_text_group": { "type": ["string", "null"] },
        "mapping_method": {
          "enum": [
            "explicit_mapping",
            "exact_basename",
            "normalized_basename",
            "unique_slide_number",
            "title_sequence_alignment",
            "manual_confirmed",
            "sequence_fallback"
          ]
        },
        "mapping_confidence": { "enum": ["high", "medium", "low"] },
        "mapping_status": { "enum": ["mapped", "needs_review", "blocked"] },
        "spoken_text": { "type": "string", "minLength": 1 },
        "spoken_text_sha256": { "$ref": "#/$defs/sha256" },
        "supplementary_information": { "$ref": "#/$defs/stringArray" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "qa": { "$ref": "#/$defs/qa" }
      }
    }
  }
}
