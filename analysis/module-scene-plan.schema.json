{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "basis-re-module-scene-plan.schema.json",
  "title": "Basis RE module scene plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "external_module_id",
    "source_inventory",
    "text_mapping",
    "target_structure_version",
    "scenes",
    "qa"
  ],
  "properties": {
    "schema_version": { "const": "basisReScenePlan/v1" },
    "module_id": { "type": "string", "pattern": "^RE[1-5]$" },
    "external_module_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source_inventory": { "type": "string", "minLength": 1 },
    "text_mapping": { "type": "string", "minLength": 1 },
    "target_structure_version": { "const": "external-svg-asset-package-handoff/v1" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "qa": { "$ref": "#/$defs/qa" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues", "warnings", "open_questions"],
      "properties": {
        "issues": { "$ref": "#/$defs/stringArray" },
        "warnings": { "$ref": "#/$defs/stringArray" },
        "open_questions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit",
        "output_slide_number",
        "scene_id",
        "sequence_group_id",
        "mode",
        "source_slides",
        "primary_source_slide",
        "mapping_type",
        "text_mapping_refs",
        "spoken_text_sources",
        "spoken_text",
        "source_text_trigger",
        "content_title",
        "target_svg",
        "internal_manifest",
        "element_animation_plan",
        "final_svg_basename",
        "final_manifest_basename",
        "remove_powerpoint_speaker",
        "animation_plan",
        "qa"
      ],
      "properties": {
        "work_unit": { "type": "string", "pattern": "^slide_[0-9]{3,}$" },
        "output_slide_number": { "type": "integer", "minimum": 1 },
        "scene_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "sequence_group_id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["standalone", "build_sequence"] },
        "source_slides": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "primary_source_slide": { "type": "integer", "minimum": 1 },
        "mapping_type": { "enum": ["direct", "merged"] },
        "text_mapping_refs": { "$ref": "#/$defs/stringArray" },
        "spoken_text_sources": { "$ref": "#/$defs/stringArray" },
        "spoken_text": { "type": "string", "minLength": 1 },
        "source_text_trigger": { "type": "string", "minLength": 1 },
        "content_title": { "type": "string", "minLength": 1 },
        "target_svg": { "type": "string", "pattern": "\\.svg$" },
        "internal_manifest": { "type": "string", "pattern": "\\.json$" },
        "element_animation_plan": { "type": "string", "pattern": "element-animation-plan\\.json$" },
        "final_svg_basename": { "type": "string", "pattern": "\\.svg$" },
        "final_manifest_basename": { "type": "string", "pattern": "\\.animation\\.v1\\.json$" },
        "remove_powerpoint_speaker": { "type": "boolean" },
        "animation_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "rationale", "strategy", "state_count", "public_targets", "semantic_groups", "steps"],
          "properties": {
            "decision": { "enum": ["static", "animated", "needs_review"] },
            "rationale": { "type": "string", "minLength": 1 },
            "strategy": { "enum": ["static", "semantic_reveal", "source_state_sequence", "unplanned"] },
            "state_count": { "type": "integer", "minimum": 0 },
            "public_targets": { "$ref": "#/$defs/stringArray" },
            "semantic_groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["group_id", "label", "role", "members"],
                "properties": {
                  "group_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
                  "label": { "type": "string", "minLength": 1 },
                  "role": { "type": "string", "minLength": 1 },
                  "members": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order", "target_id", "action", "source_text"],
                "properties": {
                  "order": { "type": "integer", "minimum": 1 },
                  "target_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
                  "action": { "enum": ["show", "hide", "highlight", "draw", "transform"] },
                  "source_text": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "decision": { "const": "animated" } } },
              "then": {
                "properties": {
                  "public_targets": { "minItems": 1 },
                  "semantic_groups": { "minItems": 1 },
                  "steps": { "minItems": 1 }
                }
              }
            },
            {
              "if": { "properties": { "decision": { "enum": ["static", "needs_review"] } } },
              "then": {
                "properties": {
                  "public_targets": { "maxItems": 0 },
                  "semantic_groups": { "maxItems": 0 },
                  "steps": { "maxItems": 0 }
                }
              }
            }
          ]
        },
        "qa": { "$ref": "#/$defs/qa" }
      }
    }
  }
}
