{
  "schema": "companyBrandTokens/v1",
  "brand": {
    "companyName": "RelTest Education",
    "profile": "reltest-education",
    "subbrand": "education",
    "version": "1.0.0",
    "effectiveDate": "2026-07-31",
    "source": [
      "source-materials/brand/Corporate_Design_RELTEST_19.pdf",
      "brand/reltest-education-style-guide.md",
      "brand/design-quality-bar.md"
    ],
    "personality": [
      "modern",
      "reduziert",
      "international",
      "technisch",
      "praezise",
      "professionell",
      "digital-affin",
      "didaktisch-klar"
    ],
    "avoid": [
      "solutions-dominante-cyanpalette",
      "academy-altmarke",
      "verspielt",
      "bunt-zufaellig",
      "ueberladen",
      "generische-ki-aesthetik",
      "dekorative-effekte"
    ]
  },
  "canvas": {
    "artifactScope": "content-svg",
    "embeddingTarget": "powerpoint-slide",
    "aspectRatio": "16:9",
    "preferredViewBox": "0 0 1920 1080",
    "supportsTransparentBackground": true
  },
  "spacing": {
    "outerMargin": 96,
    "contentMargin": 88,
    "sectionGap": 56,
    "blockGap": 32,
    "tightGap": 16,
    "cardPadding": 32
  },
  "typography": {
    "displayFontFamily": "\"Oxanium\", \"Archivo\", Arial, sans-serif",
    "bodyFontFamily": "\"Archivo\", Arial, Helvetica, sans-serif",
    "fallbackFontFamily": "Arial, Helvetica, sans-serif",
    "fontAssets": {
      "oxaniumVariable": "brand/fonts/oxanium/Oxanium-wght.ttf",
      "archivoVariable": "brand/fonts/archivo/Archivo-wdth-wght.ttf",
      "archivoItalicVariable": "brand/fonts/archivo/Archivo-Italic-wdth-wght.ttf",
      "license": "SIL Open Font License 1.1"
    },
    "title": 54,
    "contentTitle": 44,
    "subtitle": 32,
    "body": 26,
    "caption": 20,
    "minReadable": 18,
    "minCaption": 14,
    "hierarchy": {
      "h1": {
        "family": "Oxanium",
        "weight": 700,
        "lineHeight": 1.15,
        "allCapsRule": "Only for short titles up to 3-4 words or about 25 characters.",
        "allCapsLetterSpacing": "0.03em"
      },
      "h2": {
        "family": "Oxanium",
        "weight": 600,
        "acceptedWeightRange": [500, 600],
        "lineHeight": 1.15
      },
      "h3": {
        "family": "Archivo",
        "weight": 600,
        "lineHeight": 1.15
      },
      "body": {
        "family": "Archivo",
        "weight": 400,
        "lineHeight": 1.35
      },
      "emphasis": {
        "family": "Archivo",
        "weight": 600
      },
      "caption": {
        "family": "Archivo",
        "weight": 400,
        "style": "italic"
      }
    },
    "alignment": "left",
    "listMarker": "en-dash"
  },
  "colors": {
    "backgroundLight": "#F7F9FC",
    "backgroundDark": "#031334",
    "panelLight": "#FFFFFF",
    "panelSoft": "#E6F6EE",
    "textPrimary": "#031334",
    "textSecondary": "#25495F",
    "textInverse": "#FFFFFF",
    "brandPrimary": "#031334",
    "brandPrimary80": "#35425D",
    "brandPrimary60": "#687185",
    "brandPrimary40": "#9AA1AE",
    "brandPrimary20": "#CDD0D6",
    "brandPrimary10": "#E6E7EB",
    "accentPrimary": "#00A754",
    "accentPrimary80": "#33B976",
    "accentPrimary60": "#66CA98",
    "accentPrimary40": "#99DCBA",
    "accentPrimary20": "#CCEDDD",
    "accentPrimary10": "#E6F6EE",
    "educationGold": "#E9B400",
    "educationCoral": "#EC6244",
    "educationSteelCyan": "#0C84B4",
    "educationGraphiteBlue": "#25495F",
    "lineMuted": "#CDD0D6",
    "gridMuted": "#E6E7EB",
    "riskLow": "#00A754",
    "riskMedium": "#E9B400",
    "riskHigh": "#EC6244",
    "black": "#000000",
    "white": "#FFFFFF"
  },
  "stroke": {
    "hairline": 1.5,
    "normal": 2.5,
    "emphasis": 4,
    "maximum": 6
  },
  "pictograms": {
    "tokenSource": "brand/reltest-education-pictogram-tokens.json",
    "styleProfile": "reltest-education-minimal-v1"
  },
  "radius": {
    "small": 8,
    "card": 18,
    "large": 28
  },
  "shadow": {
    "allowed": false
  },
  "variants": {
    "education-technical": {
      "defaultBackgroundMode": "transparent",
      "primaryAccent": "accentPrimary",
      "density": "normal"
    },
    "education-management": {
      "defaultBackgroundMode": "transparent",
      "primaryAccent": "brandPrimary",
      "density": "normal"
    },
    "education-light": {
      "defaultBackgroundMode": "transparent",
      "primaryAccent": "accentPrimary",
      "density": "normal"
    },
    "education-dark": {
      "defaultBackgroundMode": "dark",
      "primaryAccent": "accentPrimary",
      "density": "low"
    },
    "education-minimal": {
      "defaultBackgroundMode": "transparent",
      "primaryAccent": "brandPrimary",
      "density": "dense"
    }
  },
  "qa": {
    "requiredBrandProfile": "reltest-education",
    "requiredBodyFont": "Archivo",
    "allowedDisplayFont": "Oxanium",
    "legacyBrandNamesForbidden": [
      "Reltest Academy",
      "RelTest Academy"
    ],
    "metadataRequiredFields": [
      "artifactScope",
      "embeddingTarget",
      "slideType",
      "layoutIntent",
      "takeaway",
      "density",
      "contentMode",
      "backgroundMode",
      "brandProfile",
      "brandVariant"
    ],
    "contentModes": [
      "transparent-content",
      "contained-card",
      "full-content-area"
    ],
    "backgroundModes": [
      "transparent",
      "light",
      "dark"
    ],
    "densities": [
      "low",
      "normal",
      "dense"
    ],
    "maxVisibleColors": {
      "low": 6,
      "normal": 8,
      "dense": 12
    }
  }
}
